# PostgreSQL business database used by Spring Boot and Flyway.
POSTGRES_DB=lm_platform
POSTGRES_USER=lm_platform
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/lm_platform
PLATFORM_VERSION=local
APP_DOMAIN=datc.sitp.ac.cn
HTTPS_PORT=8505
API_PORT=8510
PUBLIC_BASE_URL=https://datc.sitp.ac.cn:8505
PUBLIC_WEB_BASE_URL=https://datc.sitp.ac.cn:8505
CLIENT_MAX_BODY_SIZE=100m
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2G
MINIO_CPUS=2.0
MINIO_MEMORY=2G
REDIS_CPUS=0.5
REDIS_MEMORY=512M
AI_SERVICE_CPUS=2.0
AI_SERVICE_MEMORY=3G
BACKEND_CPUS=2.0
BACKEND_MEMORY=2G
GATEWAY_CPUS=1.0
GATEWAY_MEMORY=256M
# Redis and MinIO credentials must be replaced before shared deployment.
REDIS_PASSWORD=change-me
SESSION_TIMEOUT=8h
MINIO_ROOT_USER=lm_platform
MINIO_ROOT_PASSWORD=change-me-now
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=lm-platform-files
MAX_UPLOAD_BYTES=104857600

# Organization OAuth2 identity-gateway registration.
OAUTH2_SERVER=http://sso.sitp.ac.cn
OAUTH2_CLIENT_ID=replace-me
OAUTH2_CLIENT_SECRET=replace-me
OAUTH2_REDIRECT_URI=https://datc.sitp.ac.cn:8505
OAUTH2_SEND_STATE=false
SESSION_COOKIE_SECURE=true

# Optional one-time bootstrap for the first local management account.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123
ADMIN_INITIAL_DISPLAY_NAME=系统管理员

# Python AI gateway and model-provider configuration.
AI_SERVICE_BASE_URL=http://localhost:8001
AI_DEEPSEEK_API_KEY=replace-with-deepseek-api-key
AI_MODEL_CONFIG_PATH=config/models.json
# Title generation currently shares the DeepSeek chat model.
# After registering a lightweight vLLM model, replace this value with its model key.
AI_TITLE_MODEL=deepseek-chat
AI_MAX_CONTEXT_MESSAGES=40
KNOWLEDGE_CHUNK_TOKENS=600
KNOWLEDGE_OVERLAP_TOKENS=100
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
