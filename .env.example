# PostgreSQL business database used by Spring Boot and Flyway.
POSTGRES_DB=lm_platform
POSTGRES_USER=lm_platform
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/lm_platform
# Redis and MinIO credentials must be replaced before shared deployment.
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=lm_platform
MINIO_ROOT_PASSWORD=change-me-now

# Organization OAuth2 identity-gateway registration.
OAUTH2_SERVER=http://172.16.4.250:30801
OAUTH2_CLIENT_ID=replace-me
OAUTH2_CLIENT_SECRET=replace-me
OAUTH2_REDIRECT_URI=http://localhost:8080/api/auth/oauth2/callback

# Python AI gateway and model-provider configuration.
AI_SERVICE_BASE_URL=http://localhost:8001
AI_DEEPSEEK_API_KEY=replace-with-deepseek-api-key
AI_MODEL_CONFIG_PATH=config/models.json
# Title generation currently shares the DeepSeek chat model.
# After registering a lightweight vLLM model, replace this value with its model key.
AI_TITLE_MODEL=deepseek-chat
